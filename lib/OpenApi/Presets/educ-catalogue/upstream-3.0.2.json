        "/favourite/create": {
            "get": {
                "summary": "Create a new favourite item for the logged-in user.\nIf the LO is already a favourite, does nothing.",
                "description": "Create a new favourite item for the logged-in user",
                "operationId": "2fb3acc8fdb585a1ad1fe51a4b0cb6fb",
                "parameters": [
                    {
                        "name": "course_id",
                        "in": "query",
                        "description": "Course ID",
                        "schema": {
                            "type": "integer",
                            "nullable": false
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FavouriteCreateResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/favourite/delete": {
            "get": {
                "summary": "Removes a learning opportunity from the favourite list oft the logged-in user.\nIf the LO is not a favourite, does nothing.",
