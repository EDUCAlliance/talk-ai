{
    "openapi": "3.0.0",
    "info": {
        "title": "Course Catalogue API functions",
        "version": "3.0.2"
    },
    "servers": [
        {
            "url": "https://catalogue.educalliance.eu/api/api/"
        }
    ],
    "paths": {
        "/application/get-status": {
            "get": {
                "summary": "Returns the application status for a Course (and the Current User if any).\nDoes not require a valid user being logged in over SAML.\n\nUsage: .../application/get-status?course_id=1234\n\nResponse structure (JSON formatted)\n- success: bool\n- error: string|null -- error message in case of failure; may be omitted or null in case of success\n- (the attributes below are only provided in case of success)\n- user_status: string -- status of application for the current user as per Course::applicationStatus()\n- application_open: bool -- whether the course is open for application; does not take user-specific constraints into account\n- application_accepts_data: bool -- see Course::applicationAcceptsData()\n- application_data: array -- application data for the current user\n    - expected keys are always present but corresponding values might be null\n- can_apply: bool -- whether the current user can apply to the course\n- reason: string -- why can_apply is false (displayed to the end user)",
                "description": "Returns the application status for a Course (and the Current User if any)",
                "operationId": "33b95b85a7f51c7b39b776bc344d4100",
                "parameters": [
                    {
                        "name": "course_id",
                        "in": "query",
                        "description": "Course ID",
                        "schema": {
                            "type": "integer",
                            "nullable": false
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApplicationStatusResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/application/apply": {
            "get": {
                "summary": "Applies the Current User to a Course.\nRequires a valid user being logged in over SAML.\n\nUsage: .../application/apply?course_id=1234&application_data[motivation]=text&create=1\n\nResponse structure (JSON formatted)\n- success: bool\n- error: string|null -- error message in case of failure; omitted or null in case of success",
                "description": "Applies the current user to a course",
                "operationId": "ad0e6a0cd27b491e57625c94d0968d4a",
                "parameters": [
                    {
                        "name": "course_id",
                        "in": "query",
                        "description": "Course ID",
                        "schema": {
                            "type": "integer",
                            "nullable": false
                        }
                    },
                    {
                        "name": "create",
                        "in": "query",
                        "description": "Tells whether the application must be created or updated",
                        "schema": {
                            "type": "boolean",
                            "nullable": false
                        }
                    },
                    {
                        "name": "application_data",
                        "in": "query",
                        "description": "Application data",
                        "schema": {
                            "type": "string",
                            "nullable": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/application/unapply": {
            "get": {
                "summary": "Unapplies the Current User from a Course.\nRequires a valid user being logged in over SAML.\n\nUsage: .../application/unapply?course_id=1234\n\nResponse structure (JSON formatted)\n- success: bool\n- error: string|null -- error message in case of failure; omitted or null in case of success",
                "description": "Applies the current user to a course",
                "operationId": "9c6f92ef7431dd2333e6e4a6a77086d7",
                "parameters": [
                    {
                        "name": "course_id",
                        "in": "query",
                        "description": "Course ID",
                        "schema": {
                            "type": "integer",
                            "nullable": false
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/course/list": {
            "get": {
                "summary": "Loads the next offset of the course datasheets",
                "operationId": "7c6eab1373e871d5cc2543f5b02fb48b",
                "parameters": [
                    {
                        "name": "learning_type_id",
                        "in": "query",
                        "description": "Filter value(s), list of comma-separated integers",
                        "schema": {
                            "type": "string",
                            "default": ""
                        }
                    },
                    {
                        "name": "discipline_id",
                        "in": "query",
                        "description": "Filter value(s), list of comma-separated integers",
                        "schema": {
                            "type": "string",
                            "default": ""
                        }
                    },
                    {
                        "name": "target_group",
                        "in": "query",
                        "description": "Filter value(s), list of comma-separated integers",
                        "schema": {
                            "type": "string",
                            "default": ""
                        }
                    },
                    {
                        "name": "mobility_format_id",
                        "in": "query",
                        "description": "Filter value(s), list of comma-separated integers",
                        "schema": {
                            "type": "string",
                            "default": ""
                        }
                    },
                    {
                        "name": "semester_id",
                        "in": "query",
                        "description": "Filter value(s), list of comma-separated integers",
                        "schema": {
                            "type": "string",
                            "default": ""
                        }
                    },
                    {
                        "name": "FilterFirst",
                        "in": "query",
                        "description": "True if the filter changed, reload from the beginning",
                        "schema": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Number of courses to retrieve",
                        "schema": {
                            "type": "integer",
                            "default": 0
                        }
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "description": "The offset of the courses retrieved (for paging)",
                        "schema": {
                            "type": "integer",
                            "default": 0
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "@id for a single course by ID",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "state",
                        "in": "query",
                        "description": "Decides the OPEN or the CLOSED state of the courses",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "OPEN",
                                "CLOSED"
                            ],
                            "nullable": false
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/ListParams"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoadResponse"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Loads the next offset of the course datasheets",
                "description": "Loads the next page of the course datasheets (load more data).\nCalled from the 'course/default' action too.",
                "operationId": "b632a70f9ea13519b7e9b9e5677c1d8e",
                "parameters": [
                    {
