        "/admin/course": {
            "get": {
                "summary": "The default action lists Courses.\nIf an id is specified, the action displays the course details as presented to the public.",
                "description": "The default action lists Courses.",
                "operationId": "d9c9adced4f47fe87a5e5532666e75f1",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "[fieldName=>value,...] to filter the results",
                        "schema": {
                            "type": "object",
                            "nullable": true
                        }
                    },
                    {
                        "name": "orders",
                        "in": "query",
                        "description": "order input by fields, example: [\"id\"=>null, \"name\"=>\"ASC;1\",...]",
                        "schema": {
                            "type": "object",
                            "nullable": true
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "the current page request by the user",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "id",
                        "in": "query",
                        "description": "course id",
                        "schema": {
                            "type": "integer",
                            "nullable": true
                        }
                    },
                    {
                        "name": "output",
                        "in": "query",
                        "description": "output format (CSV)",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "CSV"
                            ],
                            "nullable": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success (JSON or CSV) ",
                        "content": {
                            "text/csv": {},
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/adminDefaultCourseResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
