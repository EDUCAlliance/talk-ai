{
  "name": "educai",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "^22.0.0",
    "npm": "^10.5.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --mode development build",
    "watch": "vite --mode development build --watch",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src",
    "stylelint": "stylelint src/**/*.vue src/**/*.scss src/**/*.css",
    "test:frontend": "node --test tests/frontend/*.test.mjs"
  },
  "type": "module",
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "overrides": {
    "fast-uri": "3.1.9",
    "fast-xml-builder": "1.3.1",
    "@nextcloud/eslint-plugin": {
      "fast-xml-parser": "5.7.2"
    },
    "dompurify": "^3.4.17",
    "qs": "^6.17.1",
    "@babel/core": "^7.29.6",
    "@microsoft/api-extractor": {
      "minimatch": {
        "brace-expansion": "^5.0.6"
      }
    },
    "floating-vue": "5.2.2"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.5.2",
    "@nextcloud/dialogs": "7.2.0",
    "@nextcloud/files": "3.13.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^2.2.1",
    "@nextcloud/vue": "9.11.0",
    "vue": "^3.5.44",
    "vue-material-design-icons": "^5.3.1",
    "@nextcloud/initial-state": "^2.2.0"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^8.4.2",
    "@nextcloud/stylelint-config": "^3.1.0",
    "@nextcloud/vite-config": "^2.5.4",
    "vite": "^7.3.6",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-stylelint": "^6.0.2",
    "@vue/compiler-sfc": "^3.5.44",
    "jsdom": "^27.4.0"
  }
}
