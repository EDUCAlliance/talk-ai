                            "default": ""
                        }
                    },
                    {
                        "name": "discipline_id",
                        "in": "query",
                        "description": "Filter value(s), list of comma-separated integers",
                        "schema": {
                            "type": "string",
                            "default": ""
                        }
                    },
                    {
                        "name": "target_group",
                        "in": "query",
                        "description": "Filter value(s), list of comma-separated integers",
                        "schema": {
                            "type": "string",
                            "default": ""
                        }
                    },
                    {
                        "name": "mobility_format_id",
                        "in": "query",
                        "description": "Filter value(s), list of comma-separated integers",
                        "schema": {
                            "type": "string",
                            "default": ""
                        }
                    },
                    {
                        "name": "semester_id",
                        "in": "query",
                        "description": "Filter value(s), list of comma-separated integers",
                        "schema": {
                            "type": "string",
                            "default": ""
                        }
                    },
                    {
                        "name": "FilterFirst",
                        "in": "query",
                        "description": "True if the filter changed, reload from the beginning",
                        "schema": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Number of courses to retrieve",
                        "schema": {
                            "type": "integer",
                            "default": 0
                        }
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "description": "The offset of the courses retrieved (for paging)",
                        "schema": {
                            "type": "integer",
                            "default": 0
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "@id for a single course by ID",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "state",
                        "in": "query",
                        "description": "Decides the OPEN or the CLOSED state of the courses",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "OPEN",
                                "CLOSED"
                            ],
                            "nullable": false
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/ListParams"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoadResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
