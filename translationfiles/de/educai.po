#: src/utils/apiConnections.js
msgid "This operation uses its own server; the connection base address is not one of them."
msgstr "Diese Operation verwendet einen eigenen Server; die Basisadresse der Verbindung gehört nicht dazu."

#: src/utils/apiConnections.js
msgid "Choose the authentication this operation uses."
msgstr "Wähle die Authentifizierung, die diese Operation verwendet."

#: src/utils/apiConnections.js
msgid "The chosen authentication does not match the connection."
msgstr "Die gewählte Authentifizierung passt nicht zur Verbindung."

#: src/utils/apiConnections.js
msgid "The API key header of the document differs from the connection."
msgstr "Der API-Schlüssel-Header des Dokuments weicht von der Verbindung ab."

#: src/utils/apiConnections.js
msgid "The connection has no stored credential."
msgstr "Für die Verbindung sind keine Zugangsdaten gespeichert."

#: src/utils/apiConnections.js
msgid "The authentication choice is invalid."
msgstr "Die Auswahl der Authentifizierung ist ungültig."

#: src/utils/apiConnections.js
msgid "Fixed values must be query parameters."
msgstr "Feste Werte müssen Query-Parameter sein."

#: src/utils/apiConnections.js
msgid "A fixed value names a parameter the operation does not have."
msgstr "Ein fester Wert nennt einen Parameter, den die Operation nicht hat."

#: src/utils/apiConnections.js
msgid "A fixed value does not match the parameter definition."
msgstr "Ein fester Wert passt nicht zur Parameterdefinition."

#: src/utils/apiConnections.js
msgid "The label is invalid."
msgstr "Die Bezeichnung ist ungültig."

#: src/utils/apiConnections.js
msgid "The description is invalid."
msgstr "Die Beschreibung ist ungültig."

#: src/utils/apiConnections.js
msgid "The result mapping is invalid."
msgstr "Die Ergebniszuordnung ist ungültig."

#: src/utils/apiConnections.js
msgid "The records location must be a JSON pointer such as /data, or empty for the whole response."
msgstr "Der Ort der Datensätze muss ein JSON-Pointer wie /data sein oder leer für die ganze Antwort."

#: src/utils/apiConnections.js
msgid "The ID field must be a JSON pointer such as /id."
msgstr "Das ID-Feld muss ein JSON-Pointer wie /id sein."

#: src/utils/apiConnections.js
msgid "The title field must be a JSON pointer such as /title."
msgstr "Das Titelfeld muss ein JSON-Pointer wie /title sein."

#: src/utils/apiConnections.js
msgid "Up to 12 extra fields are possible."
msgstr "Es sind bis zu 12 zusätzliche Felder möglich."

#: src/utils/apiConnections.js
msgid "Field names use lowercase letters, digits and underscores, are unique and are not id, title or url."
msgstr "Feldnamen bestehen aus Kleinbuchstaben, Ziffern und Unterstrichen, sind eindeutig und lauten nicht id, title oder url."

#: src/utils/apiConnections.js
msgid "Each extra field needs a JSON pointer such as /summary."
msgstr "Jedes zusätzliche Feld braucht einen JSON-Pointer wie /summary."

#: src/utils/apiConnections.js
msgid "The source link settings are invalid. Templates must be HTTPS and use {id}."
msgstr "Die Einstellungen für den Quelllink sind ungültig. Vorlagen müssen HTTPS verwenden und {id} enthalten."

#: src/utils/apiConnections.js
msgid "A link field needs at least one accepted HTTPS origin."
msgstr "Ein Linkfeld braucht mindestens einen akzeptierten HTTPS-Ursprung."

#: src/utils/apiConnections.js
msgid "Paging fields must be JSON pointers."
msgstr "Paging-Felder müssen JSON-Pointer sein."

#: src/utils/apiConnections.js
msgid "Only GET operations can be offered."
msgstr "Nur GET-Operationen können angeboten werden."

#: src/utils/apiConnections.js
msgid "The name or description suggests the operation changes data."
msgstr "Name oder Beschreibung deuten darauf hin, dass die Operation Daten ändert."

#: src/utils/apiConnections.js
msgid "Request bodies are not supported."
msgstr "Request-Bodys werden nicht unterstützt."

#: src/utils/apiConnections.js
msgid "The document declares no successful response."
msgstr "Das Dokument beschreibt keine erfolgreiche Antwort."

#: src/utils/apiConnections.js
msgid "The successful response is not JSON."
msgstr "Die erfolgreiche Antwort ist kein JSON."

#: src/utils/apiConnections.js
msgid "The response description could not be read; check the result mapping with a test call."
msgstr "Die Antwortbeschreibung konnte nicht gelesen werden; prüfe die Ergebniszuordnung mit einem Testaufruf."

#: src/utils/apiConnections.js
msgid "The response schema could not be read; check the result mapping with a test call."
msgstr "Das Antwortschema konnte nicht gelesen werden; prüfe die Ergebniszuordnung mit einem Testaufruf."

#: src/utils/apiConnections.js
msgid "The required authentication is not supported (only bearer tokens, API keys in a header or anonymous access)."
msgstr "Die erforderliche Authentifizierung wird nicht unterstützt (nur Bearer-Tokens, API-Schlüssel im Header oder anonymer Zugriff)."

#: src/utils/apiConnections.js
msgid "The security requirements are invalid."
msgstr "Die Sicherheitsanforderungen sind ungültig."

#: src/utils/apiConnections.js
msgid "The security schemes are invalid."
msgstr "Die Sicherheitsschemata sind ungültig."

#: src/utils/apiConnections.js
msgid "This operation declares its own server."
msgstr "Diese Operation gibt einen eigenen Server an."

#: src/utils/apiConnections.js
msgid "A server address is invalid."
msgstr "Eine Serveradresse ist ungültig."

#: src/utils/apiConnections.js
msgid "The server list is invalid."
msgstr "Die Serverliste ist ungültig."

#: src/utils/apiConnections.js
msgid "A server address uses a variable without default."
msgstr "Eine Serveradresse verwendet eine Variable ohne Standardwert."

#: src/utils/apiConnections.js
msgid "The document marks this operation as deprecated."
msgstr "Das Dokument markiert diese Operation als veraltet."

#: src/utils/apiConnections.js
msgid "The operation definition is invalid."
msgstr "Die Definition der Operation ist ungültig."

#: src/utils/apiConnections.js
msgid "Several operations use the same operationId; IDs are assigned from method and path instead."
msgstr "Mehrere Operationen verwenden dieselbe operationId; die IDs werden stattdessen aus Methode und Pfad gebildet."

#: src/utils/apiConnections.js
msgid "Callbacks are ignored."
msgstr "Callbacks werden ignoriert."

#: src/utils/apiConnections.js
msgid "An optional parameter with unsupported features is not offered to the bot."
msgstr "Ein optionaler Parameter mit nicht unterstützten Eigenschaften wird dem Bot nicht angeboten."

#: src/utils/apiConnections.js
msgid "The path is invalid."
msgstr "Der Pfad ist ungültig."

#: src/utils/apiConnections.js
msgid "The path definition is invalid."
msgstr "Die Pfaddefinition ist ungültig."

#: src/utils/apiConnections.js
msgid "The path template is invalid."
msgstr "Die Pfadvorlage ist ungültig."

#: src/utils/apiConnections.js
msgid "A path parameter is not defined."
msgstr "Ein Pfadparameter ist nicht definiert."

#: src/utils/apiConnections.js
msgid "A path parameter is not marked as required."
msgstr "Ein Pfadparameter ist nicht als erforderlich markiert."

#: src/utils/apiConnections.js
msgid "A path parameter does not occur in the path."
msgstr "Ein Pfadparameter kommt im Pfad nicht vor."

#: src/utils/apiConnections.js
msgid "The parameter list is invalid."
msgstr "Die Parameterliste ist ungültig."

#: src/utils/apiConnections.js
msgid "The operation has too many parameters."
msgstr "Die Operation hat zu viele Parameter."

#: src/utils/apiConnections.js
msgid "A parameter definition is invalid."
msgstr "Eine Parameterdefinition ist ungültig."

#: src/utils/apiConnections.js
msgid "A parameter is defined twice."
msgstr "Ein Parameter ist doppelt definiert."

#: src/utils/apiConnections.js
msgid "A parameter is deprecated."
msgstr "Ein Parameter ist veraltet."

#: src/utils/apiConnections.js
msgid "Only path and query parameters are supported (no headers or cookies)."
msgstr "Nur Pfad- und Query-Parameter werden unterstützt (keine Header oder Cookies)."

#: src/utils/apiConnections.js
msgid "A parameter name contains unsupported characters."
msgstr "Ein Parametername enthält nicht unterstützte Zeichen."

#: src/utils/apiConnections.js
msgid "A parameter uses an unsupported serialization style."
msgstr "Ein Parameter verwendet einen nicht unterstützten Serialisierungsstil."

#: src/utils/apiConnections.js
msgid "A parameter uses \"content\" instead of a schema."
msgstr "Ein Parameter verwendet „content“ statt eines Schemas."

#: src/utils/apiConnections.js
msgid "A parameter has no schema."
msgstr "Ein Parameter hat kein Schema."

#: src/utils/apiConnections.js
msgid "A parameter allows empty values, which is not supported."
msgstr "Ein Parameter erlaubt leere Werte, was nicht unterstützt wird."

#: src/utils/apiConnections.js
msgid "A parameter allows reserved characters, which is not supported."
msgstr "Ein Parameter erlaubt reservierte Zeichen, was nicht unterstützt wird."

#: src/utils/apiConnections.js
msgid "Lists in path parameters are not supported."
msgstr "Listen in Pfadparametern werden nicht unterstützt."

#: src/utils/apiConnections.js
msgid "A parameter schema is invalid."
msgstr "Ein Parameterschema ist ungültig."

#: src/utils/apiConnections.js
msgid "A parameter schema refers to itself."
msgstr "Ein Parameterschema verweist auf sich selbst."

#: src/utils/apiConnections.js
msgid "A parameter schema has no type."
msgstr "Ein Parameterschema hat keinen Typ."

#: src/utils/apiConnections.js
msgid "A parameter uses an unsupported type."
msgstr "Ein Parameter verwendet einen nicht unterstützten Typ."

#: src/utils/apiConnections.js
msgid "Object parameters are not supported."
msgstr "Objektparameter werden nicht unterstützt."

#: src/utils/apiConnections.js
msgid "Nested lists are not supported."
msgstr "Verschachtelte Listen werden nicht unterstützt."

#: src/utils/apiConnections.js
msgid "A list parameter does not define its items."
msgstr "Ein Listenparameter definiert seine Elemente nicht."

#: src/utils/apiConnections.js
msgid "Parameter schemas with allOf, anyOf, oneOf or not are not supported."
msgstr "Parameterschemata mit allOf, anyOf, oneOf oder not werden nicht unterstützt."

#: src/utils/apiConnections.js
msgid "A parameter schema uses an unsupported keyword."
msgstr "Ein Parameterschema verwendet ein nicht unterstütztes Schlüsselwort."

#: src/utils/apiConnections.js
msgid "A parameter uses an unsupported format."
msgstr "Ein Parameter verwendet ein nicht unterstütztes Format."

#: src/utils/apiConnections.js
msgid "Parameter patterns are not supported; the operation would accept values the API rejects."
msgstr "Parametermuster werden nicht unterstützt; die Operation würde Werte annehmen, die die API ablehnt."

#: src/utils/apiConnections.js
msgid "This API tool is currently not available."
msgstr "Dieses API-Tool ist derzeit nicht verfügbar."

#: src/utils/apiConnections.js
msgid "The test values do not match the operation."
msgstr "Die Testwerte passen nicht zur Operation."

#: src/utils/apiConnections.js
msgid "The address is not allowed by the server network policy."
msgstr "Die Adresse ist durch die Netzwerkrichtlinie des Servers nicht erlaubt."

#: src/utils/apiConnections.js
msgid "The request would leave the approved API address."
msgstr "Die Anfrage würde die freigegebene API-Adresse verlassen."

#: src/utils/apiConnections.js
msgid "The API answered with a redirect, which is not followed."
msgstr "Die API hat mit einer Weiterleitung geantwortet, der nicht gefolgt wird."

#: src/utils/apiConnections.js
msgid "The API rejected the configured authentication."
msgstr "Die API hat die eingerichtete Authentifizierung abgelehnt."

#: src/utils/apiConnections.js
msgid "The API found no matching resource."
msgstr "Die API hat keine passende Ressource gefunden."

#: src/utils/apiConnections.js
msgid "The API rate limit is reached. Try again later."
msgstr "Das Ratenlimit der API ist erreicht. Versuche es später erneut."

#: src/utils/apiConnections.js
msgid "The API reported an error."
msgstr "Die API hat einen Fehler gemeldet."

#: src/utils/apiConnections.js
msgid "The API rejected the request."
msgstr "Die API hat die Anfrage abgelehnt."

#: src/utils/apiConnections.js
msgid "The API did not answer in time."
msgstr "Die API hat nicht rechtzeitig geantwortet."

#: src/utils/apiConnections.js
msgid "The API could not be reached."
msgstr "Die API ist nicht erreichbar."

#: src/utils/apiConnections.js
msgid "The API sent a compressed response, which is refused."
msgstr "Die API hat eine komprimierte Antwort gesendet, die abgelehnt wird."

#: src/utils/apiConnections.js
msgid "The response is larger than allowed."
msgstr "Die Antwort ist größer als erlaubt."

#: src/utils/apiConnections.js
msgid "The response is nested too deeply."
msgstr "Die Antwort ist zu tief verschachtelt."

#: src/utils/apiConnections.js
msgid "The API answered with invalid JSON."
msgstr "Die API hat mit ungültigem JSON geantwortet."

#: src/utils/apiConnections.js
msgid "The stored credential cannot be read. Replace it."
msgstr "Die gespeicherten Zugangsdaten können nicht gelesen werden. Ersetze sie."

#: src/utils/apiConnections.js
msgid "The API connection could not be processed. Check the server log for details."
msgstr "Die API-Verbindung konnte nicht verarbeitet werden. Details findest du im Serverprotokoll."

#: src/utils/apiConnections.js
msgid "No authentication (the document declares none)"
msgstr "Keine Authentifizierung (das Dokument gibt keine an)"

#: src/utils/apiConnections.js
msgid "Anonymous access (offered by the document)"
msgstr "Anonymer Zugriff (vom Dokument angeboten)"

#: src/utils/apiConnections.js
msgid "{scheme} ({mode})"
msgstr "{scheme} ({mode})"

#: src/utils/apiConnections.js
msgid "Fixed value \"{line}\" needs the form name = value."
msgstr "Fester Wert „{line}“ braucht die Form Name = Wert."

#: src/utils/apiConnections.js
msgid "Extra field \"{line}\" needs the form name = /pointer."
msgstr "Zusätzliches Feld „{line}“ braucht die Form Name = /Pointer."

#: src/utils/apiConnections.js
msgid "\"{name}\" is required."
msgstr "„{name}“ ist erforderlich."

#: src/utils/apiConnections.js
msgid "\"{name}\" does not have the expected type."
msgstr "„{name}“ hat nicht den erwarteten Typ."

#: src/utils/apiConnections.js
msgid "parameters"
msgstr "Parameter"

#: src/utils/apiConnections.js
msgid "authentication"
msgstr "Authentifizierung"

#: src/utils/apiConnections.js
msgid "servers"
msgstr "Server"

#: src/utils/apiConnections.js
msgid "response"
msgstr "Antwort"

#: src/utils/apiConnections.js
msgid "support"
msgstr "Unterstützung"

#: src/utils/apiConnections.js
msgid "summary"
msgstr "Zusammenfassung"

#: src/utils/apiConnections.js
msgid "description"
msgstr "Beschreibung"

#: src/utils/apiConnections.js
