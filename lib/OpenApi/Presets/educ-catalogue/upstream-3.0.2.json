                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FavouriteDeleteResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No favourite courses found"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        },
        "/login": {
            "get": {
                "summary": "Redirects to the discovery/IdP login page and then back to the age defined in the 'ReturnTo' parameter.\nOptional parameter: 'errorUrl', redirect here when an error occurs.\nAfter the login process, the status can be queried using the '/login/status' action.\nIf already logged in, the login status is returned.",
                "description": "Logs in to SAML session and backend",
                "operationId": "28f997474fabd18a1e98ee36eeeb5300",
                "parameters": [
                    {
                        "name": "ReturnTo",
                        "in": "query",
                        "description": "Redirect URL for successful login",
                        "schema": {
                            "description": "If null, the current URL will be used",
                            "type": "string",
                            "nullable": true
                        }
                    },
                    {
                        "name": "ErrorURL",
                        "in": "query",
                        "description": "Redirect URL for error case",
                        "schema": {
                            "description": "If null, the current URL will be used",
                            "type": "string",
                            "nullable": true
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Successful login or error case"
                    },
                    "200": {
                        "description": "Already logged in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginStatusResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/login/status": {
            "get": {
                "description": "Returns login status and attribute values",
                "operationId": "324d5d0279801fca678c6f13502b9c22",
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginStatusResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/login/logout": {
            "get": {
                "description": "Logs out from SAML session and backend",
                "operationId": "79568934c1b96d8d8af1b8796ed73503",
                "parameters": [
                    {
                        "name": "ReturnTo",
                        "in": "query",
                        "description": "Redirect URL for successful logout",
                        "schema": {
                            "description": "If null, the current URL will be used",
                            "type": "string",
                            "nullable": true
                        }
                    },
                    {
                        "name": "ErrorURL",
                        "in": "query",
                        "description": "Redirect URL for error case",
                        "schema": {
                            "description": "If null, the current URL will be used",
                            "type": "string",
                            "nullable": true
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Successful login or error case"
                    }
                }
            }
        },
        "/version": {
            "get": {
                "summary": "Returns the actual version number of the API.",
                "description": "The returned value is based on the latest git tag extracted during build time and placed in the image as a 'version' file.",
                "operationId": "440b78f9574483ca8d216d58951ca9c1",
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "oneOf": [
                                        {
                                            "schema": "Schema",
                                            "description": "Version",
                                            "properties": {
                                                "version": {
                                                    "type": "string"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
